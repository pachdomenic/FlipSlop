<?xml version="1.0" encoding="utf-8"?>
<!-- Widget ids and learned panel sizes only make sense on the device they came from. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
