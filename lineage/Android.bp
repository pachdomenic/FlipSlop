//
// FlipSlop as a privileged system app.
//
// The APK is built with Gradle (see update-prebuilt.sh) and imported here, so
// the ROM build does not depend on the Compose / Material 3 Expressive versions
// that happen to be in prebuilts/sdk.
//

android_app_import {
    name: "FlipSlop",
    apk: "prebuilt/FlipSlop.apk",
    presigned: true,
    privileged: true,
    system_ext_specific: true,
    required: [
        "FlipSlopFrameworksOverlay",
        "default-permissions-com.tuki.flipslop.xml",
        "privapp-permissions-com.tuki.flipslop.xml",
        "sysconfig-com.tuki.flipslop.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-com.tuki.flipslop.xml",
    src: "privapp-permissions-com.tuki.flipslop.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "default-permissions-com.tuki.flipslop.xml",
    src: "default-permissions-com.tuki.flipslop.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "sysconfig-com.tuki.flipslop.xml",
    src: "sysconfig-com.tuki.flipslop.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}
